# 复制为 .env（本仓库已带一份可用的本地配置）
DATABASE_URL="postgresql://yueqiu:yueqiu@127.0.0.1:5432/yueqiu?schema=public"
# 切 SQLite： DATABASE_URL="file:./dev.db"

JWT_SECRET="请替换为随机长字符串"
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_DAYS="30"
PORT="8787"

# ---------------------------- 短信渠道 ----------------------------
# dev    = 不接网关，验证码打在日志里并随接口回显（本地 / CI）
# aliyun = 阿里云短信 dysmsapi，下面四项必填
#
# 注意：dev 通道会把验证码回显给前端，等于没有登录。
# 所以它默认关闭，必须显式 ALLOW_DEV_SMS=true 才能开；生产环境无论如何都禁止。
SMS_PROVIDER="dev"
ALLOW_DEV_SMS="true"
# ALIYUN_SMS_ACCESS_KEY_ID=""
# ALIYUN_SMS_ACCESS_KEY_SECRET=""
# ALIYUN_SMS_SIGN_NAME=""
# ALIYUN_SMS_TEMPLATE_CODE=""

# ---------------------------- 生产环境硬校验 ----------------------------
# NODE_ENV=production 时，下面这些不合规就直接拒绝启动：
#   JWT_SECRET（≥32 位随机、不能是占位符）、SMS_PROVIDER（不能是 dev）、
#   ALLOW_DEV_SMS / DEV_SMS（必须 false）、CORS_ORIGINS（必须非空）、DATABASE_URL
NODE_ENV="development"
# 允许的跨域来源，逗号分隔。生产必须配。
CORS_ORIGINS=""
# 反向代理后面跑时置 true（限流按真实 IP 计数需要它）
TRUST_PROXY="false"

# ---------------------------- 限流 ----------------------------
# 按手机号（防刷短信烧钱）与按 IP（要宽松，避免 NAT 出口的同事被误伤）分开设
RATE_LIMIT_SMS_PER_PHONE="5"      # 每手机号每小时可发几条验证码
RATE_LIMIT_SMS_PER_IP="100"       # 每 IP 每小时可发几条验证码
RATE_LIMIT_LOGIN_PER_IP="60"      # 每 IP 每 15 分钟可试登录多少次
RATE_LIMIT_API_PER_IP="300"       # 每 IP 每分钟可打多少次接口

# ---------------------------- 支付渠道 ----------------------------
# dev    = 模拟网关，调用即置为已支付
# wechat = 微信支付 APIv3 Native 下单 + 回调验签/解密
PAY_PROVIDER="dev"
# 支付回调要外部可达；本地调试可填内网穿透地址
# PUBLIC_BASE_URL="https://example.ngrok.app"
# WECHAT_APPID=""
# WECHAT_MCHID=""
# WECHAT_CERT_SERIAL_NO=""
# 商户私钥（apiclient_key.pem 的内容，换行用 \n 转义或直接多行）
# WECHAT_PRIVATE_KEY_PEM=""
# APIv3 密钥，32 位
# WECHAT_API_V3_KEY=""
# 微信平台证书公钥（用于回调验签）
# WECHAT_PLATFORM_PUBLIC_KEY_PEM=""
