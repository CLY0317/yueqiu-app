# 生产环境变量模板：复制成 deploy/.env.production 后按需修改
#   cp .env.production.example deploy/.env.production
# 该文件已在 .gitignore 里，不要提交真实密钥。

# ---------- 域名与证书 ----------
# 有域名就填域名（Caddy 自动申请并续期 Let's Encrypt 证书）
# 只有 IP 就填 http://你的IP（明文，Let's Encrypt 不签发 IP 证书）
DOMAIN=yueqiu.example.com
SITE_ADDRESS=http://yueqiu.example.com
ACME_EMAIL=ops@example.com

# ---------- 版本（回滚就是改这个标签） ----------
YUEQIU_VERSION=latest

# ---------- 数据库 ----------
POSTGRES_USER=yueqiu
POSTGRES_PASSWORD=改成随机长密码
POSTGRES_DB=yueqiu

# ---------- 应用 ----------
# 至少 32 位随机串，不能用占位符（启动时会校验）
JWT_SECRET=改成至少32位的随机字符串
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_DAYS=30
# 必须是自己的域名，逗号分隔
CORS_ORIGINS=https://yueqiu.example.com
LOG_LEVEL=info

# ---------- 短信（生产不能是 dev） ----------
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 支付 ----------
PAY_PROVIDER=dev
# 接微信时填：
# PUBLIC_BASE_URL=https://yueqiu.example.com
# WECHAT_APPID=
# WECHAT_MCHID=
# WECHAT_CERT_SERIAL_NO=
# WECHAT_PRIVATE_KEY_PEM=
# WECHAT_API_V3_KEY=
# WECHAT_PLATFORM_PUBLIC_KEY_PEM=

# ---------- 运维 ----------
# 告警通道：dingtalk: / wecom: / url:
ALERT_WEBHOOK=
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_FAIL_THRESHOLD=3
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# 异地备份：把文件推走，例如 rsync / rclone / aws s3 cp
BACKUP_UPLOAD_CMD=
